ANTHROPIC_API_KEY=
# Must be a real Anthropic API model ID (passed directly as the `model` param),
# NOT the descriptive `model_version` tracking label used in raw_grades rows
# (e.g. schema.sql's "claude-sonnet-5-zeroshot" is a bookkeeping label, not a model ID).
GRADING_MODEL_VERSION=claude-sonnet-5
RESULT_LOGGER_BACKEND=local
RESULT_LOGGER_LOCAL_DIR=./grading_results
S3_BUCKET=

# Not secrets (public identifiers for a Cognito app client with no client secret) —
# these defaults in config.py already match the real pool, so overriding here is
# only needed for a different environment/pool.
COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=us-east-2_hZY5RNs81
COGNITO_APP_CLIENT_ID=4tpkjhn2v74cjr9rbmca3kjih8
