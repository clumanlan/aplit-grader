# Copy to .env and adjust if the backend isn't running on the default port.
VITE_API_BASE_URL=http://localhost:8000

# Not secrets (this Cognito app client has no client secret) — defaults in
# auth/cognito.ts already match the real pool, so overriding here is only
# needed for a different environment/pool.
VITE_COGNITO_REGION=us-east-2
VITE_COGNITO_APP_CLIENT_ID=4tpkjhn2v74cjr9rbmca3kjih8
